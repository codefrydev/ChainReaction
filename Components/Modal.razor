@namespace ChainReaction.Components

@if (IsOpen)
{
    <div class="modal-overlay fixed inset-0 z-50 overflow-y-auto bg-slate-950/80 backdrop-blur-md animate-fade-in p-3 sm:p-4 flex items-center justify-center" @onclick="OnBackdropClick">
        <div class="modal-panel relative w-full max-w-[min(100%,36rem)] max-h-[calc(100dvh-2rem)] flex flex-col glass-card rounded-3xl shadow-2xl border border-slate-700/60 animate-scale-in text-slate-100 overflow-hidden" @onclick:stopPropagation>
            @if (!string.IsNullOrEmpty(Title))
            {
                <div class="shrink-0 px-5 py-4 pr-14 border-b border-slate-700/50 bg-slate-800/40 flex items-center justify-between">
                    <h2 class="text-lg sm:text-xl font-bold text-slate-100 flex items-center gap-2">
                        @Title
                    </h2>
                </div>
            }
            <div class="flex-1 min-h-0 overflow-y-auto p-4 sm:p-5 text-sm sm:text-base leading-relaxed">
                @ChildContent
            </div>
            @if (Footer is not null)
            {
                <div class="shrink-0 px-5 py-3.5 border-t border-slate-700/50 bg-slate-800/40">
                    @Footer
                </div>
            }
            <button class="absolute top-3 right-3 h-8 w-8 sm:h-9 sm:w-9 flex items-center justify-center rounded-xl bg-slate-800/80 hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 border border-slate-700/60 hover:border-rose-500/40 transition-all duration-150 active:scale-95 z-10" 
                    @onclick="Close"
                    aria-label="Close modal">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;

    private async Task Close()
    {
        if (IsOpenChanged.HasDelegate)
        {
            await IsOpenChanged.InvokeAsync(false);
        }
    }

    private async Task OnBackdropClick()
    {
        if (CloseOnBackdrop)
        {
            await Close();
        }
    }
}
