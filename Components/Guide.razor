<div class="max-w-full min-w-0 space-y-2 sm:space-y-3">

    <!-- General Rules -->
    <div class="bg-gradient-to-br from-blue-100 to-sky-100 rounded-xl overflow-hidden border-2 border-blue-600/50 shadow-sm">
        <button type="button" @onclick='() => ToggleSection("general")'
                class="w-full cursor-pointer px-3 sm:px-4 py-2.5 sm:py-3 font-black text-sm sm:text-base text-blue-900 flex items-center justify-between select-none hover:bg-blue-200/50 transition-colors text-left"
                style="font-family: 'Comic Sans MS', cursive;"
                aria-expanded="@IsOpen("general")">
            <span class="flex items-center gap-2 min-w-0">
                <span class="shrink-0">📋</span>
                <span class="truncate">General Rules</span>
            </span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 shrink-0 text-blue-700 transition-transform @(IsOpen("general") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </button>
        @if (IsOpen("general"))
        {
            <div class="px-3 sm:px-4 py-2.5 sm:py-3 bg-white/80 border-t border-blue-200/50">
                <ul class="space-y-2 text-xs sm:text-sm text-blue-900 font-semibold" style="font-family: 'Comic Sans MS', cursive;">
                    <li class="flex items-start gap-2">
                        <span class="shrink-0">✅</span>
                        <span><strong class="text-blue-800">Cell ownership:</strong> Each cell holds only one player's orbs</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="shrink-0">✅</span>
                        <span><strong class="text-blue-800">Placement:</strong> You can't place on another player's cells</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="shrink-0">✅</span>
                        <span><strong class="text-blue-800">Players:</strong> Minimum 2 players required</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="shrink-0">✅</span>
                        <span><strong class="text-blue-800">Turn order:</strong> Queue order; eliminated players are skipped</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="shrink-0">🏆</span>
                        <span><strong class="text-blue-800">Victory:</strong> Last player standing wins</span>
                    </li>
                </ul>
            </div>
        }
    </div>

    <!-- Corner Cells -->
    <div class="bg-gradient-to-br from-amber-100 to-orange-100 rounded-xl overflow-hidden border-2 border-amber-600/50 shadow-sm">
        <button type="button" @onclick='() => ToggleSection("corner")'
                class="w-full cursor-pointer px-3 sm:px-4 py-2.5 sm:py-3 font-black text-sm sm:text-base text-amber-900 flex items-center justify-between select-none hover:bg-amber-200/50 transition-colors text-left"
                style="font-family: 'Comic Sans MS', cursive;"
                aria-expanded="@IsOpen("corner")">
            <span class="flex items-center gap-2 min-w-0">
                <span class="h-6 w-6 shrink-0 rounded-lg bg-amber-500 flex items-center justify-center text-white text-xs font-black border border-amber-700">1</span>
                <span class="truncate">Corner Cells</span>
            </span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 shrink-0 text-amber-700 transition-transform @(IsOpen("corner") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </button>
        @if (IsOpen("corner"))
        {
            <div class="px-3 sm:px-4 py-2.5 sm:py-3 bg-white/80 border-t border-amber-200/50 space-y-2">
                <img src="CornerRule.gif" loading="lazy" class="w-full max-h-48 sm:max-h-64 object-contain rounded-xl border-2 border-amber-600/30 bg-white" alt="Corner cell rule demonstration" />
                <p class="text-xs sm:text-sm text-amber-900 leading-relaxed font-bold" style="font-family: 'Comic Sans MS', cursive;">
                    <strong class="text-amber-800">Capacity:</strong> 1 orb max.
                    <strong class="text-amber-800"> Burst:</strong> Spreads to 2 neighbors.
                </p>
            </div>
        }
    </div>

    <!-- Edge Cells -->
    <div class="bg-gradient-to-br from-emerald-100 to-green-100 rounded-xl overflow-hidden border-2 border-emerald-600/50 shadow-sm">
        <button type="button" @onclick='() => ToggleSection("edge")'
                class="w-full cursor-pointer px-3 sm:px-4 py-2.5 sm:py-3 font-black text-sm sm:text-base text-emerald-900 flex items-center justify-between select-none hover:bg-emerald-200/50 transition-colors text-left"
                style="font-family: 'Comic Sans MS', cursive;"
                aria-expanded="@IsOpen("edge")">
            <span class="flex items-center gap-2 min-w-0">
                <span class="h-6 w-6 shrink-0 rounded-lg bg-emerald-500 flex items-center justify-center text-white text-xs font-black border border-emerald-700">2</span>
                <span class="truncate">Edge Cells</span>
            </span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 shrink-0 text-emerald-700 transition-transform @(IsOpen("edge") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </button>
        @if (IsOpen("edge"))
        {
            <div class="px-3 sm:px-4 py-2.5 sm:py-3 bg-white/80 border-t border-emerald-200/50 space-y-2">
                <img src="EdgeRule.gif" loading="lazy" class="w-full max-h-48 sm:max-h-64 object-contain rounded-xl border-2 border-emerald-600/30 bg-white" alt="Edge cell rule demonstration" />
                <p class="text-xs sm:text-sm text-emerald-900 leading-relaxed font-bold" style="font-family: 'Comic Sans MS', cursive;">
                    <strong class="text-emerald-800">Capacity:</strong> 2 orbs max.
                    <strong class="text-emerald-800"> Burst:</strong> Spreads to 3 neighbors.
                </p>
            </div>
        }
    </div>

    <!-- Center Cells -->
    <div class="bg-gradient-to-br from-purple-100 to-pink-100 rounded-xl overflow-hidden border-2 border-purple-600/50 shadow-sm">
        <button type="button" @onclick='() => ToggleSection("center")'
                class="w-full cursor-pointer px-3 sm:px-4 py-2.5 sm:py-3 font-black text-sm sm:text-base text-purple-900 flex items-center justify-between select-none hover:bg-purple-200/50 transition-colors text-left"
                style="font-family: 'Comic Sans MS', cursive;"
                aria-expanded="@IsOpen("center")">
            <span class="flex items-center gap-2 min-w-0">
                <span class="h-6 w-6 shrink-0 rounded-lg bg-purple-500 flex items-center justify-center text-white text-xs font-black border border-purple-700">3</span>
                <span class="truncate">Center Cells</span>
            </span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 shrink-0 text-purple-700 transition-transform @(IsOpen("center") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </button>
        @if (IsOpen("center"))
        {
            <div class="px-3 sm:px-4 py-2.5 sm:py-3 bg-white/80 border-t border-purple-200/50 space-y-2">
                <img src="RestRule.gif" loading="lazy" class="w-full max-h-48 sm:max-h-64 object-contain rounded-xl border-2 border-purple-600/30 bg-white" alt="Center cell rule demonstration" />
                <p class="text-xs sm:text-sm text-purple-900 leading-relaxed font-bold" style="font-family: 'Comic Sans MS', cursive;">
                    <strong class="text-purple-800">Capacity:</strong> 3 orbs max.
                    <strong class="text-purple-800"> Burst:</strong> Spreads to 4 neighbors.
                </p>
            </div>
        }
    </div>

</div>

@code {
    private string? openSection;

    private void ToggleSection(string section)
    {
        openSection = openSection == section ? null : section;
    }

    private bool IsOpen(string section) => openSection == section;
}
