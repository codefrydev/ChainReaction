<div class="max-w-full min-w-0 space-y-3">

    <!-- Objective & Basics -->
    <div class="rounded-2xl overflow-hidden border border-slate-700/60 bg-slate-800/40">
        <button type="button" @onclick='() => ToggleSection("general")'
                class="w-full px-4 py-3 font-bold text-sm sm:text-base text-amber-400 flex items-center justify-between hover:bg-slate-700/30 transition-colors text-left"
                aria-expanded="@IsOpen("general")">
            <span class="flex items-center gap-2.5 min-w-0">
                <span class="text-base">📋</span>
                <span class="truncate">Objective & Turn Rules</span>
            </span>
            <svg class="w-4 h-4 text-amber-400/80 transition-transform @(IsOpen("general") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </button>
        @if (IsOpen("general"))
        {
            <div class="px-4 py-3 bg-slate-900/60 border-t border-slate-700/40 text-slate-300 text-xs sm:text-sm space-y-2.5">
                <div class="flex items-start gap-2.5">
                    <span class="text-emerald-400 font-bold text-sm">1.</span>
                    <span><strong>Ownership:</strong> Each cell can hold orbs from only one player at a time.</span>
                </div>
                <div class="flex items-start gap-2.5">
                    <span class="text-emerald-400 font-bold text-sm">2.</span>
                    <span><strong>Placing Orbs:</strong> You may only place an orb into an empty cell or a cell you already own.</span>
                </div>
                <div class="flex items-start gap-2.5">
                    <span class="text-emerald-400 font-bold text-sm">3.</span>
                    <span><strong>Chain Reactions:</strong> When a cell exceeds its capacity, it explodes and sends orbs to all adjacent neighbor cells, capturing them!</span>
                </div>
                <div class="flex items-start gap-2.5">
                    <span class="text-emerald-400 font-bold text-sm">4.</span>
                    <span><strong>Elimination & Victory:</strong> Once every player has played at least one move, any player left with 0 orbs is eliminated. Last player standing wins!</span>
                </div>
            </div>
        }
    </div>

    <!-- Corner Cells -->
    <div class="rounded-2xl overflow-hidden border border-slate-700/60 bg-slate-800/40">
        <button type="button" @onclick='() => ToggleSection("corner")'
                class="w-full px-4 py-3 font-bold text-sm sm:text-base text-amber-300 flex items-center justify-between hover:bg-slate-700/30 transition-colors text-left"
                aria-expanded="@IsOpen("corner")">
            <span class="flex items-center gap-2.5 min-w-0">
                <span class="px-2 py-0.5 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold text-xs">Cap: 1</span>
                <span class="truncate">Corner Cells (2 Neighbors)</span>
            </span>
            <svg class="w-4 h-4 text-amber-300/80 transition-transform @(IsOpen("corner") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </button>
        @if (IsOpen("corner"))
        {
            <div class="px-4 py-3 bg-slate-900/60 border-t border-slate-700/40 space-y-2">
                <div class="rounded-xl overflow-hidden border border-slate-700/50 bg-slate-950 flex items-center justify-center p-1">
                    <img src="CornerRule.gif" loading="lazy" class="max-h-44 object-contain rounded-lg" alt="Corner cell explosion demonstration" />
                </div>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                    Holds <strong class="text-amber-300">1 orb</strong>. Adding a 2nd orb causes it to detonate instantly and shoot 2 orbs into its 2 orthogonal neighbors.
                </p>
            </div>
        }
    </div>

    <!-- Edge Cells -->
    <div class="rounded-2xl overflow-hidden border border-slate-700/60 bg-slate-800/40">
        <button type="button" @onclick='() => ToggleSection("edge")'
                class="w-full px-4 py-3 font-bold text-sm sm:text-base text-emerald-300 flex items-center justify-between hover:bg-slate-700/30 transition-colors text-left"
                aria-expanded="@IsOpen("edge")">
            <span class="flex items-center gap-2.5 min-w-0">
                <span class="px-2 py-0.5 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold text-xs">Cap: 2</span>
                <span class="truncate">Edge Cells (3 Neighbors)</span>
            </span>
            <svg class="w-4 h-4 text-emerald-300/80 transition-transform @(IsOpen("edge") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </button>
        @if (IsOpen("edge"))
        {
            <div class="px-4 py-3 bg-slate-900/60 border-t border-slate-700/40 space-y-2">
                <div class="rounded-xl overflow-hidden border border-slate-700/50 bg-slate-950 flex items-center justify-center p-1">
                    <img src="EdgeRule.gif" loading="lazy" class="max-h-44 object-contain rounded-lg" alt="Edge cell explosion demonstration" />
                </div>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                    Holds up to <strong class="text-emerald-300">2 orbs</strong>. Adding a 3rd orb causes it to explode and launch 3 orbs into adjacent neighbors.
                </p>
            </div>
        }
    </div>

    <!-- Center Cells -->
    <div class="rounded-2xl overflow-hidden border border-slate-700/60 bg-slate-800/40">
        <button type="button" @onclick='() => ToggleSection("center")'
                class="w-full px-4 py-3 font-bold text-sm sm:text-base text-indigo-300 flex items-center justify-between hover:bg-slate-700/30 transition-colors text-left"
                aria-expanded="@IsOpen("center")">
            <span class="flex items-center gap-2.5 min-w-0">
                <span class="px-2 py-0.5 rounded-lg bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 font-bold text-xs">Cap: 3</span>
                <span class="truncate">Center Cells (4 Neighbors)</span>
            </span>
            <svg class="w-4 h-4 text-indigo-300/80 transition-transform @(IsOpen("center") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </button>
        @if (IsOpen("center"))
        {
            <div class="px-4 py-3 bg-slate-900/60 border-t border-slate-700/40 space-y-2">
                <div class="rounded-xl overflow-hidden border border-slate-700/50 bg-slate-950 flex items-center justify-center p-1">
                    <img src="RestRule.gif" loading="lazy" class="max-h-44 object-contain rounded-lg" alt="Center cell explosion demonstration" />
                </div>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                    Holds up to <strong class="text-indigo-300">3 orbs</strong>. Adding a 4th orb triggers a massive 4-way blast into top, bottom, left, and right neighbors!
                </p>
            </div>
        }
    </div>

    <!-- AI Bot & Strategies -->
    <div class="rounded-2xl overflow-hidden border border-slate-700/60 bg-slate-800/40">
        <button type="button" @onclick='() => ToggleSection("bot")'
                class="w-full px-4 py-3 font-bold text-sm sm:text-base text-purple-300 flex items-center justify-between hover:bg-slate-700/30 transition-colors text-left"
                aria-expanded="@IsOpen("bot")">
            <span class="flex items-center gap-2.5 min-w-0">
                <span class="text-base">🤖</span>
                <span class="truncate">Playing vs AI Bots & Tips</span>
            </span>
            <svg class="w-4 h-4 text-purple-300/80 transition-transform @(IsOpen("bot") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </button>
        @if (IsOpen("bot"))
        {
            <div class="px-4 py-3 bg-slate-900/60 border-t border-slate-700/40 text-slate-300 text-xs sm:text-sm space-y-2.5">
                <div class="flex items-start gap-2.5">
                    <span class="text-purple-400 font-bold">🟢</span>
                    <span><strong>Rookie (Easy):</strong> Great for beginners. Makes casual placements with relaxed threat evaluation.</span>
                </div>
                <div class="flex items-start gap-2.5">
                    <span class="text-amber-400 font-bold">🟡</span>
                    <span><strong>Tactical (Medium):</strong> Avoids placing orbs near enemy critical cells and aggressively captures corners and edges.</span>
                </div>
                <div class="flex items-start gap-2.5">
                    <span class="text-red-400 font-bold">🔴</span>
                    <span><strong>Master (Hard):</strong> Full simulation-powered AI. Predicts cascading chain reactions and launches game-ending combinations.</span>
                </div>
                <div class="p-2.5 rounded-xl bg-purple-950/40 border border-purple-800/40 text-[11px] text-purple-200">
                    💡 <strong>Pro Tip:</strong> Claim Corners and Edges early on. Placing an orb in a center cell adjacent to an opponent's critical cell is an open invitation for a takeover!
                </div>
            </div>
        }
    </div>

</div>

@code {
    private string openSection = "general";

    private void ToggleSection(string section)
    {
        openSection = openSection == section ? string.Empty : section;
    }

    private bool IsOpen(string section) => openSection == section;
}
