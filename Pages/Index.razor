@page "/Game"
@using ChainReaction.Model
@using ChainReaction.Components

<PageTitle>Chain Reaction - Live Match</PageTitle>

<SlidingBubble />

<div class="relative z-10 h-screen h-[100dvh] w-full max-w-[1600px] mx-auto flex flex-col lg:flex-row items-stretch justify-between p-2 sm:p-3 lg:p-4 gap-2 sm:gap-3 lg:gap-4 overflow-hidden safe-top safe-bottom select-none">
    
    <!-- ======================================================== -->
    <!-- DESKTOP / WIDE SCREEN SIDE HUD PANEL (Visible on lg+ screens) -->
    <!-- ======================================================== -->
    <aside class="hidden lg:flex w-72 xl:w-80 flex-col justify-between p-4 glass-card rounded-3xl shrink-0 h-full overflow-hidden border border-slate-700/60 shadow-2xl">
        <!-- Top: Match Controls & Actions -->
        <div class="space-y-3">
            <div class="flex items-center justify-between pb-3 border-b border-slate-700/60">
                <div>
                    <h2 class="text-lg font-black text-white tracking-tight" style="font-family: 'Outfit', sans-serif;">
                        Chain Reaction
                    </h2>
                    <p class="text-[11px] font-bold text-amber-400">
                        Round @(currentRound) · Move #@(totalMoves)
                    </p>
                </div>

                <div class="flex items-center gap-1.5">
                    <button type="button"
                            class="btn-subtle w-8 h-8 rounded-xl text-slate-300 hover:text-white flex items-center justify-center text-xs transition-all active:scale-95 @(Config.Dhwani ? "text-amber-400" : "text-slate-500")"
                            @onclick="ToggleSound"
                            title="@(Config.Dhwani ? "Mute Sound" : "Enable Sound")">
                        @if (Config.Dhwani)
                        {
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                            </svg>
                        }
                        else
                        {
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
                            </svg>
                        }
                    </button>
                    <button type="button"
                            class="btn-subtle w-8 h-8 rounded-xl text-slate-300 hover:text-white flex items-center justify-center text-xs transition-all active:scale-95"
                            @onclick="() => helpOpen = true"
                            title="View Rules">
                        <span class="font-black text-xs text-amber-400">?</span>
                    </button>
                </div>
            </div>

            <!-- Current Turn Showcase Card -->
            @if (CurrentPlayer is not null)
            {
                <div class="p-3.5 rounded-2xl shadow-lg border transition-all duration-300 flex items-center gap-3"
                     style="background: @CurrentPlayer.ColorFormed(); border-color: @CurrentPlayer.DarkerBorderColor; color: @CurrentPlayer.ContrastTextColor;">
                    <div class="w-10 h-10 rounded-full border-2 border-white/80 shadow-md flex items-center justify-center font-black text-sm shrink-0 bg-black/10">
                        @if (CurrentPlayer.IsBot)
                        {
                            <span class="text-base @(isBotThinking ? "animate-bounce" : "")">🤖</span>
                        }
                        else
                        {
                            <span>@(livePlayerList.IndexOf(CurrentPlayer) + 1)</span>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-1.5">
                            <span class="text-[10px] uppercase font-black tracking-wider opacity-85 block">
                                @(CurrentPlayer.IsBot ? (isBotThinking ? "Bot Thinking..." : "Bot Turn") : "Active Turn")
                            </span>
                            @if (CurrentPlayer.IsBot)
                            {
                                <span class="text-[9px] font-black px-1.5 py-0.2 rounded bg-black/30 border border-white/20 uppercase">
                                    @CurrentPlayer.BotDifficulty
                                </span>
                            }
                        </div>
                        <p class="text-base font-extrabold truncate leading-tight">@CurrentPlayer.Name</p>
                        <span class="text-[11px] font-semibold opacity-90">@CurrentPlayer.CellCount cells · @CurrentPlayer.OrbCount orbs</span>
                    </div>
                </div>
            }

            <!-- Live Player Standings List -->
            <div class="space-y-1.5 pt-1">
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider px-1">Player Standings</span>
                <div class="custom-scrollbar max-h-[38vh] xl:max-h-[44vh] overflow-y-auto space-y-1.5 pr-1">
                    @for (int i = 0; i < initialPlayerList.Count; i++)
                    {
                        var p = initialPlayerList[i];
                        var isTurn = CurrentPlayer?.Name == p.Name;
                        var isDead = p.IsEliminated;

                        <div class="p-2 rounded-xl flex items-center justify-between gap-2 border transition-all @(isTurn ? "bg-slate-800/90 border-amber-400/60 shadow-md" : "bg-slate-900/50 border-slate-800") @(isDead ? "opacity-35 grayscale" : "")">
                            <div class="flex items-center gap-2 min-w-0">
                                <div class="w-6 h-6 rounded-full border border-white/40 shadow-sm shrink-0 flex items-center justify-center text-[10px] font-black"
                                     style="background: @p.ColorFormed(); color: @p.ContrastTextColor;">
                                    @if (p.IsBot)
                                    {
                                        <span class="text-[11px]">🤖</span>
                                    }
                                    else
                                    {
                                        <span>@(i + 1)</span>
                                    }
                                </div>
                                <div class="min-w-0">
                                    <span class="text-xs font-bold text-slate-200 truncate block max-w-[100px]">@p.Name</span>
                                    @if (p.IsBot)
                                    {
                                        <span class="text-[9px] text-slate-400 font-semibold block leading-none">@p.BotDifficulty AI</span>
                                    }
                                </div>
                            </div>

                            <div class="flex items-center gap-1.5 shrink-0">
                                @if (!isDead)
                                {
                                    <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">
                                        @p.CellCount c
                                    </span>
                                }
                                else
                                {
                                    <span class="text-[9px] font-black px-1.5 py-0.5 rounded bg-red-950 text-red-400 border border-red-800/50 uppercase">
                                        OUT
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Bottom Action Buttons in Sidebar -->
        <div class="pt-3 border-t border-slate-700/60 flex items-center gap-2">
            <button type="button"
                    class="flex-1 py-2.5 px-3 rounded-xl btn-subtle text-slate-300 hover:text-white flex items-center justify-center gap-1.5 text-xs font-bold transition-all active:scale-95"
                    @onclick="() => confirmLeaveOpen = true">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Exit Home</span>
            </button>

            <button type="button"
                    class="flex-1 py-2.5 px-3 rounded-xl bg-amber-500/20 border border-amber-500/40 hover:bg-amber-500/30 text-amber-300 hover:text-amber-200 flex items-center justify-center gap-1.5 text-xs font-bold transition-all active:scale-95"
                    @onclick="() => confirmRestartOpen = true">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span>Restart</span>
            </button>
        </div>
    </aside>

    <!-- ======================================================== -->
    <!-- MOBILE / PORTRAIT TOP BAR & HUD (Visible on screens < lg) -->
    <!-- ======================================================== -->
    <div class="flex lg:hidden flex-col shrink-0 w-full max-w-4xl mx-auto space-y-1">
        <!-- Top Control Bar -->
        <header class="w-full px-2 pt-1 pb-1 flex items-center justify-between gap-2">
            <!-- Left: Home & Restart -->
            <div class="flex items-center gap-1.5">
                <button type="button"
                        class="btn-subtle px-2.5 py-1.5 rounded-xl text-slate-300 hover:text-white flex items-center gap-1 text-xs font-semibold transition-all active:scale-95"
                        @onclick="() => confirmLeaveOpen = true"
                        title="Exit to Home">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    <span class="hidden sm:inline">Home</span>
                </button>

                <button type="button"
                        class="btn-subtle px-2.5 py-1.5 rounded-xl text-slate-300 hover:text-white flex items-center gap-1 text-xs font-semibold transition-all active:scale-95"
                        @onclick="() => confirmRestartOpen = true"
                        title="Restart match">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    <span class="hidden sm:inline">Restart</span>
                </button>
            </div>

            <!-- Center: Turn Status Pill -->
            @if (CurrentPlayer is not null)
            {
                <div class="px-3 py-1 rounded-full shadow-md flex items-center gap-2 transition-all duration-300 border"
                     style="background: @CurrentPlayer.ColorFormed(); border-color: @CurrentPlayer.DarkerBorderColor; color: @CurrentPlayer.ContrastTextColor;">
                    @if (CurrentPlayer.IsBot)
                    {
                        <span class="text-xs @(isBotThinking ? "animate-spin" : "")">🤖</span>
                    }
                    else
                    {
                        <div class="w-2 h-2 rounded-full bg-white shadow-sm animate-pulse shrink-0"></div>
                    }
                    <span class="text-xs font-bold tracking-wide truncate max-w-[130px] sm:max-w-[180px]">
                        @(CurrentPlayer.IsBot && isBotThinking ? $"{CurrentPlayer.Name} thinking…" : $"{CurrentPlayer.Name}'s Turn")
                    </span>
                </div>
            }

            <!-- Right: Round Info, Sound & Rules -->
            <div class="flex items-center gap-1">
                <div class="px-2 py-0.5 rounded-full bg-slate-800/80 border border-slate-700/60 text-[10px] font-semibold text-slate-300 flex items-center gap-1 shadow-sm">
                    <span class="text-amber-400">R@(currentRound)</span>
                </div>

                <button type="button"
                        class="btn-subtle w-7 h-7 rounded-xl text-slate-300 hover:text-white flex items-center justify-center text-xs transition-all active:scale-95 @(Config.Dhwani ? "text-amber-400" : "text-slate-500")"
                        @onclick="ToggleSound"
                        title="@(Config.Dhwani ? "Mute Sound" : "Enable Sound")">
                    @if (Config.Dhwani)
                    {
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                        </svg>
                    }
                    else
                    {
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
                        </svg>
                    }
                </button>

                <button type="button"
                        class="btn-subtle w-7 h-7 rounded-xl text-slate-300 hover:text-white flex items-center justify-center text-xs transition-all active:scale-95"
                        @onclick="() => helpOpen = true"
                        title="View Rules">
                    <span class="font-black text-xs text-amber-400">?</span>
                </button>
            </div>
        </header>

        <!-- Mobile Player Strip -->
        @if (initialPlayerList.Count > 0)
        {
            <div class="w-full px-2 py-0.5 flex items-center justify-center gap-1.5 flex-wrap">
                @for (int i = 0; i < initialPlayerList.Count; i++)
                {
                    var p = initialPlayerList[i];
                    var isTurn = CurrentPlayer?.Name == p.Name;
                    var isDead = p.IsEliminated;

                    <div class="flex items-center gap-1 px-1.5 py-0.5 rounded-lg text-[10px] font-bold transition-all @(isTurn ? "ring-2 ring-white scale-105 shadow-md" : "opacity-75") @(isDead ? "opacity-30 grayscale" : "")"
                         style="background: @(isTurn ? p.ColorFormed() : "rgba(30, 41, 59, 0.7)"); color: @(isTurn ? p.ContrastTextColor : "#cbd5e1");">
                        <div class="w-2.5 h-2.5 rounded-full border border-white/40 shadow-sm shrink-0 flex items-center justify-center"
                             style="background: @p.ColorFormed();">
                            @if (p.IsBot)
                            {
                                <span class="text-[7px]">🤖</span>
                            }
                        </div>
                        <span class="truncate max-w-[70px] sm:max-w-[100px]">@p.Name</span>
                        @if (!isDead)
                        {
                            <span class="text-[9px] px-0.5 rounded font-semibold opacity-90 @(isTurn ? "bg-black/20" : "bg-slate-700/60")">
                                @p.CellCount c
                            </span>
                        }
                        else
                        {
                            <span class="text-[8px] px-0.5 bg-red-900/60 text-red-200 rounded font-black uppercase">OUT</span>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- ======================================================== -->
    <!-- MAIN GAME ARENA (Centered, Responsive, Max Viewport Fit) -->
    <!-- ======================================================== -->
    <main class="flex-1 min-h-0 min-w-0 flex items-center justify-center p-1 sm:p-2 lg:p-4 overflow-hidden select-none">
        @if (gridOfCells is not null && gridOfCells.Count > 0 && CurrentPlayer is not null)
        {
            <div class="game-board inline-flex flex-col p-1.5 sm:p-2 rounded-2xl glass-card border border-slate-700/60 shadow-2xl transition-all duration-300 select-none @(CurrentPlayer.IsBot ? "pointer-events-none" : "")"
                 style="box-shadow: 0 10px 40px -10px @CurrentPlayer.GlowColorFormed();">
                @foreach (var rowItem in gridOfCells)
                {
                    <div class="flex flex-row shrink-0">
                        @foreach (var cell in rowItem)
                        {
                            <CellComponent cell="cell" 
                                           CurrentPlayerName="@(CurrentPlayer.IsBot ? string.Empty : CurrentPlayer.Name)" 
                                           OnClick="@(() => UserClicked(cell))" />
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center gap-3 text-center">
                <div class="w-10 h-10 rounded-2xl bg-amber-500/20 border border-amber-400/40 flex items-center justify-center animate-spin">
                    <span class="text-lg">🎲</span>
                </div>
                <p class="text-slate-400 font-semibold text-xs">Fitting Board to Screen…</p>
            </div>
        }
    </main>

</div>

<!-- In-Game Rules Modal -->
@if (helpOpen)
{
    <Modal IsOpen="helpOpen" IsOpenChanged="(v) => helpOpen = v" Title="🎮 Chain Reaction Rules" CloseOnBackdrop="true">
        <ChildContent>
            <Guide />
        </ChildContent>
    </Modal>
}

<!-- Confirm Leave Modal -->
@if (confirmLeaveOpen)
{
    <Modal IsOpen="confirmLeaveOpen" IsOpenChanged="(v) => confirmLeaveOpen = v" Title="Leave Current Match?" CloseOnBackdrop="true">
        <ChildContent>
            <p class="text-sm text-slate-300">
                Are you sure you want to abandon the current match and return to the main setup screen? Current game progress will be lost.
            </p>
        </ChildContent>
        <Footer>
            <div class="flex items-center justify-end gap-2">
                <button type="button"
                        class="px-4 py-2 rounded-xl btn-subtle text-slate-300 font-bold text-xs"
                        @onclick="() => confirmLeaveOpen = false">
                    Keep Playing
                </button>
                <button type="button"
                        class="px-4 py-2 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold text-xs shadow-lg shadow-red-600/30"
                        @onclick="GoHome">
                    Exit Match
                </button>
            </div>
        </Footer>
    </Modal>
}

<!-- Confirm Restart Modal -->
@if (confirmRestartOpen)
{
    <Modal IsOpen="confirmRestartOpen" IsOpenChanged="(v) => confirmRestartOpen = v" Title="Restart Match?" CloseOnBackdrop="true">
        <ChildContent>
            <p class="text-sm text-slate-300">
                Restart the match from the beginning with the same players and board settings?
            </p>
        </ChildContent>
        <Footer>
            <div class="flex items-center justify-end gap-2">
                <button type="button"
                        class="px-4 py-2 rounded-xl btn-subtle text-slate-300 font-bold text-xs"
                        @onclick="() => confirmRestartOpen = false">
                    Cancel
                </button>
                <button type="button"
                        class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs shadow-lg shadow-amber-500/30"
                        @onclick="RestartMatch">
                    Restart Now
                </button>
            </div>
        </Footer>
    </Modal>
}

<!-- Victory / Game Over Modal -->
@if (dialogShown && livePlayerList.Count > 0)
{
    var winner = livePlayerList[0];
    <Modal IsOpen="dialogShown" IsOpenChanged="(v) => dialogShown = v" Title="🏆 Match Over!" CloseOnBackdrop="false">
        <ChildContent>
            <div class="space-y-4 text-center">
                <!-- Winner Showcase -->
                <div class="p-4 sm:p-5 rounded-3xl border shadow-xl flex flex-col items-center gap-3 animate-scale-in"
                     style="background: @winner.ColorFormed(); border-color: @winner.DarkerBorderColor; color: @winner.ContrastTextColor;">
                    <div class="w-16 h-16 rounded-full bg-white/20 border-2 border-white/80 shadow-lg flex items-center justify-center text-3xl animate-bounce">
                        @(winner.IsBot ? "🤖" : "👑")
                    </div>
                    <div>
                        <span class="text-xs uppercase font-black tracking-widest opacity-80">
                            @(winner.IsBot ? "AI BOT VICTORY" : "MATCH WINNER")
                        </span>
                        <h3 class="text-2xl sm:text-3xl font-black tracking-tight mt-0.5">
                            @winner.Name
                        </h3>
                        <p class="text-xs font-semibold opacity-90 mt-1">
                            @if (winner.IsBot)
                            {
                                <span>The @winner.BotDifficulty AI conquered the arena with @winner.CellCount cells!</span>
                            }
                            else
                            {
                                <span>Dominated the arena with @winner.CellCount cells!</span>
                            }
                        </p>
                    </div>
                </div>

                <!-- Final Standings -->
                <div class="space-y-2 text-left">
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-wider px-1">Final Standings</span>
                    <div class="space-y-1.5 max-h-[30vh] overflow-y-auto custom-scrollbar pr-1">
                        <!-- Winner 1st -->
                        <div class="p-2.5 rounded-xl bg-amber-500/20 border border-amber-400/50 flex items-center justify-between text-xs font-bold text-white">
                            <div class="flex items-center gap-2">
                                <span class="w-5 text-amber-400 font-black">#1</span>
                                <div class="w-4 h-4 rounded-full border border-white/60 flex items-center justify-center text-[9px]" style="background: @winner.ColorFormed();">
                                    @if (winner.IsBot) { <span>🤖</span> }
                                </div>
                                <span>@winner.Name</span>
                                @if (winner.IsBot)
                                {
                                    <span class="text-[9px] font-bold px-1 rounded bg-slate-800 text-slate-400">@winner.BotDifficulty</span>
                                }
                            </div>
                            <span class="text-amber-300">Winner @(winner.IsBot ? "🤖" : "👑")</span>
                        </div>

                        <!-- Other Players -->
                        @{
                            var rank = 2;
                            var eliminatedOrdered = lostPlayers.OrderByDescending(x => x.Value.Item3).ToList();
                            foreach (var lp in eliminatedOrdered)
                            {
                                if (lp.Key != winner.Name)
                                {
                                    var origPlayer = initialPlayerList.FirstOrDefault(p => p.Name == lp.Key);
                                    <div class="p-2 rounded-xl bg-slate-800/40 border border-slate-700/50 flex items-center justify-between text-xs text-slate-300">
                                        <div class="flex items-center gap-2">
                                            <span class="w-5 text-slate-500 font-bold">#@rank</span>
                                            <div class="w-3.5 h-3.5 rounded-full border border-white/40 flex items-center justify-center text-[7px]" style="background: @lp.Value.Item2;">
                                                @if (origPlayer?.IsBot == true) { <span>🤖</span> }
                                            </div>
                                            <span>@lp.Key</span>
                                        </div>
                                        <span class="text-slate-500 text-[11px]">Eliminated</span>
                                    </div>
                                    rank++;
                                }
                            }
                        }
                    </div>
                </div>
            </div>
        </ChildContent>
        <Footer>
            <div class="flex flex-col sm:flex-row gap-2 sm:justify-end w-full">
                <button type="button"
                        class="px-4 py-2.5 rounded-xl btn-subtle text-slate-300 font-bold text-xs hover:text-white"
                        @onclick="GoHome">
                    Exit to Setup
                </button>
                <button type="button"
                        class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-400 hover:from-amber-400 hover:to-amber-300 text-slate-950 font-black text-xs shadow-lg shadow-amber-500/25"
                        @onclick="RestartMatch">
                    Play Again 🔄
                </button>
            </div>
        </Footer>
    </Modal>
}