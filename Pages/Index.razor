@page "/Game"

<PageTitle>Chain Reaction - Game</PageTitle>

@if(gridOfCells is not null && gridOfCells.Count > 0)
{
    <div class="game-page flex justify-center items-center min-h-screen min-h-[100dvh] p-2 sm:p-4 bg-gradient-to-br from-amber-50 via-yellow-50 to-orange-50 w-full max-w-full overflow-x-auto overflow-y-auto">
        <div class="flex flex-col items-center gap-3 w-full max-w-full py-2">
            <!-- Current Player Indicator -->
            <div class="px-3 sm:px-4 md:px-6 py-2 md:py-3 rounded-2xl font-black shadow-2xl animate-bounce-cartoon text-xs sm:text-sm md:text-base transition-all duration-500 shrink-0 max-w-full text-center" 
                 style="background: linear-gradient(135deg, @Config.CurrentUserColor, color-mix(in srgb, @Config.CurrentUserColor 80%, #FFA500)); border: 3px solid color-mix(in srgb, @Config.CurrentUserColor 150%, #000000); color: color-mix(in srgb, @Config.CurrentUserColor 10%, #000000); font-family: 'Comic Sans MS', cursive;">
                <div class="flex items-center justify-center gap-2 md:gap-3">
                    <div class="w-3 h-3 sm:w-4 sm:h-4 md:w-5 md:h-5 rounded-full shadow-lg border-2 shrink-0" style="background: @Config.CurrentUserColor; border-color: color-mix(in srgb, @Config.CurrentUserColor 150%, #000000);"></div>
                    <span class="text-cartoon drop-shadow-md truncate">▶️ Current Player</span>
                </div>
            </div>

            <!-- Game Board Container -->
            <div class="game-board inline-flex flex-col backdrop-blur-lg rounded-2xl sm:rounded-3xl shadow-2xl overflow-hidden transition-all duration-500 shrink-0 max-w-full" 
                 style="background: linear-gradient(135deg, color-mix(in srgb, @Config.CurrentUserColor 15%, #FFF8DC), color-mix(in srgb, @Config.CurrentUserColor 25%, #FFEAA7)); border: 5px solid @Config.CurrentUserColor; box-shadow: 0 25px 50px -12px color-mix(in srgb, @Config.CurrentUserColor 40%, transparent), 0 0 0 4px color-mix(in srgb, @Config.CurrentUserColor 20%, transparent);">
                @foreach (var item in gridOfCells)
                {
                    <div class="flex flex-row shrink-0">
                        @foreach (var cell in item)
                        {
                            <CellComponent cell="cell" OnClick="@(()=>UserClicked(cell))" />
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="flex justify-center items-center min-h-screen bg-gradient-to-br from-amber-50 via-yellow-50 to-orange-50">
        <div class="text-center space-y-6">
            <div class="cheese-loader mx-auto"></div>
            <p class="text-xl md:text-2xl font-black text-amber-900 animate-bounce-cartoon" style="font-family: 'Comic Sans MS', cursive; text-shadow: 2px 2px 0px rgba(255,255,255,0.5);">
                🧀 Preparing the Game Board... 🐭
            </p>
        </div>
    </div>
    <style>
        .cheese-loader {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
            border-radius: 50%;
            border: 5px solid #8B5A2B;
            position: relative;
            animation: rotate-cheese 2s linear infinite;
            box-shadow: 0 10px 40px rgba(255,215,0,0.5);
        }
        .cheese-loader::before,
        .cheese-loader::after {
            content: '';
            position: absolute;
            background: #F5DEB3;
            border-radius: 50%;
            box-shadow: inset 2px 2px 5px rgba(0,0,0,0.3);
        }
        .cheese-loader::before {
            width: 20px;
            height: 20px;
            top: 20px;
            left: 30px;
        }
        .cheese-loader::after {
            width: 25px;
            height: 25px;
            bottom: 25px;
            right: 25px;
        }
        @@keyframes rotate-cheese {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    </style>
}

@if (dialogShown)
{
    <Modal IsOpen="dialogShown" IsOpenChanged="HandleGameOverModalChanged" Title="🏆 Game Over" CloseOnBackdrop="true">
        <ChildContent>
            <div class="w-full min-w-0 space-y-3">
                <p class="text-center text-xs sm:text-sm font-bold text-amber-800/90" style="font-family: 'Comic Sans MS', cursive;">
                    Final standings — last player standing wins
                </p>

                <div class="space-y-2">
                    @{int position = 1;}
                    @foreach (var player in ScoreLeaderWithTime.OrderByDescending(x => x.Value.Period))
                    {
                        var isWinner = position == 1;
                        <div class="@(isWinner ? "bg-gradient-to-r from-yellow-100 to-amber-100 border-amber-500 ring-2 ring-amber-400/40" : "bg-white/85 border-amber-200/80") flex items-center gap-2.5 sm:gap-3 p-2.5 sm:p-3 rounded-xl border-2 shadow-sm min-w-0">
                            <div class="shrink-0 w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center rounded-full font-black text-sm @(isWinner ? "bg-amber-500 text-amber-950 border-2 border-amber-700" : position == 2 ? "bg-slate-200 text-slate-700 border-2 border-slate-400" : position == 3 ? "bg-orange-200 text-orange-800 border-2 border-orange-400" : "bg-amber-100 text-amber-800 border-2 border-amber-300")" style="font-family: 'Comic Sans MS', cursive;">
                                @if (isWinner)
                                {
                                    <span>👑</span>
                                }
                                else if (position == 2)
                                {
                                    <span>2</span>
                                }
                                else if (position == 3)
                                {
                                    <span>3</span>
                                }
                                else
                                {
                                    <span>@position</span>
                                }
                            </div>

                            <div class="w-9 h-9 sm:w-10 sm:h-10 shrink-0 rounded-full border-2 border-amber-900/30 shadow-inner" style="background: @player.Value.color;"></div>

                            <div class="flex-1 min-w-0">
                                <p class="text-sm sm:text-base font-black text-amber-950 truncate" style="font-family: 'Comic Sans MS', cursive;">
                                    @player.Key
                                </p>
                                <p class="text-[11px] sm:text-xs text-amber-700/90 truncate">
                                    @if (isWinner)
                                    {
                                        <span class="font-bold text-amber-800">Winner · </span>
                                    }
                                    Survived @FormatDuration(player.Value.Period)
                                </p>
                            </div>

                            <div class="shrink-0 text-right">
                                <p class="text-[10px] uppercase tracking-wide text-amber-600/80 font-bold">Rank</p>
                                <p class="text-sm sm:text-base font-black text-amber-900" style="font-family: 'Chewy', cursive;">#@position</p>
                            </div>
                        </div>
                        position++;
                    }
                </div>
            </div>
        </ChildContent>

        <Footer>
            <button class="cartoon-btn w-full sm:w-auto sm:mx-auto sm:flex px-5 py-3 rounded-xl bg-gradient-to-br from-yellow-400 via-amber-400 to-orange-500 text-amber-900 font-black shadow-lg hover:shadow-xl transition-all duration-200 active:scale-[0.98] border-2 border-amber-800" @onclick="PlayAgain" style="font-family: 'Chewy', cursive;">
                <span class="flex items-center justify-center gap-2 text-sm sm:text-base">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
                    </svg>
                    Play Again
                </span>
            </button>
        </Footer>
    </Modal>
}

@code {
    private string FormatDuration(int seconds)
    {
        if (seconds < 60)
            return $"{seconds}s";
        
        int minutes = seconds / 60;
        int remainingSeconds = seconds % 60;
        
        if (minutes < 60)
            return $"{minutes}m {remainingSeconds}s";
        
        int hours = minutes / 60;
        int remainingMinutes = minutes % 60;
        return $"{hours}h {remainingMinutes}m";
    }
}