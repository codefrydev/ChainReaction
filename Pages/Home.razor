@page "/"
@using ChainReaction.Model
@using ChainReaction.Components

<SlidingBubble />

@if (showReleasePopup)
{
    <Modal IsOpen="showReleasePopup" IsOpenChanged="DismissReleasePopup" Title="🎉 Online Multiplayer is Live!" CloseOnBackdrop="true">
        <ChildContent>
            <div class="space-y-3.5 text-center sm:text-left text-slate-200">
                <p class="text-sm sm:text-base text-slate-300">
                    Looking to play with friends across different devices? Check out the new real-time <strong>Online Chain Reaction</strong>!
                </p>
                <div class="rounded-2xl bg-indigo-950/70 border border-indigo-500/30 p-3.5 flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <span class="text-2xl shrink-0">🌍</span>
                        <div class="min-w-0 text-left">
                            <p class="text-sm font-bold text-indigo-300 truncate">chainreaction.codefrydev.in</p>
                            <p class="text-xs text-slate-400">Multiplayer lobbies & room codes</p>
                        </div>
                    </div>
                </div>
            </div>
        </ChildContent>
        <Footer>
            <div class="flex flex-col sm:flex-row gap-2.5 sm:justify-end">
                <button type="button"
                        class="px-4 py-2.5 rounded-xl btn-subtle text-slate-300 font-semibold text-sm hover:text-white"
                        @onclick="DismissReleasePopup">
                    Stay on Local Mode
                </button>
                <a href="https://chainreaction.codefrydev.in/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-400 hover:from-amber-400 hover:to-amber-300 text-slate-950 font-bold shadow-lg shadow-amber-500/20 text-sm transition-all">
                    <span>Try Online Game</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </a>
            </div>
        </Footer>
    </Modal>
}

<main class="relative z-10 min-h-screen min-h-[100dvh] w-full max-w-full flex flex-col justify-between p-3 sm:p-5 md:p-6 overflow-x-hidden safe-bottom safe-top">
    
    <!-- Top Header Bar -->
    <div class="w-full max-w-2xl mx-auto flex items-center justify-between gap-3 shrink-0">
        <div>
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white leading-tight" style="font-family: 'Outfit', sans-serif;">
                Chain Reaction
            </h1>
            <p class="text-xs text-amber-400/90 font-bold tracking-wide">
                Single Player vs AI · Strategic Multiplayer
            </p>
        </div>

        <HelpButton />
    </div>

    <!-- Main Configuration Card -->
    <div class="w-full max-w-2xl mx-auto my-2 sm:my-3 flex-1 flex flex-col justify-center min-h-0">
        <div class="glass-card rounded-3xl p-4 sm:p-5 md:p-6 space-y-3.5 flex flex-col min-h-0">
            
            <!-- Online Game Promotion Banner -->
            <a href="https://chainreaction.codefrydev.in/"
               target="_blank"
               rel="noopener noreferrer"
               class="group flex items-center justify-between p-2.5 sm:p-3 rounded-2xl bg-slate-800/40 border border-slate-700/60 hover:border-amber-500/40 shadow-sm transition-all hover:bg-slate-800/70 shrink-0">
                <div class="flex items-center gap-3 min-w-0">
                    <span class="text-xl shrink-0 group-hover:scale-110 transition-transform">🌐</span>
                    <div class="min-w-0">
                        <p class="text-xs sm:text-sm font-bold text-slate-200 group-hover:text-amber-400 transition-colors flex items-center gap-1.5">
                            <span>Play Online with Remote Friends</span>
                            <span class="text-[10px] px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 uppercase tracking-wider font-semibold border border-amber-500/30">Web</span>
                        </p>
                        <p class="text-[11px] text-slate-400 truncate">Play across phones, tablets & laptops</p>
                    </div>
                </div>
                <svg class="w-4 h-4 text-slate-400 group-hover:text-amber-400 group-hover:translate-x-1 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                </svg>
            </a>

            <!-- Game Mode Selector (Vs Bot / Pass & Play) -->
            <div class="space-y-1.5 shrink-0">
                <div class="flex items-center justify-between">
                    <label class="text-xs sm:text-sm font-bold text-slate-200 flex items-center gap-1.5">
                        <span>🎮</span>
                        <span>Game Mode</span>
                    </label>
                    <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700">
                        @(Config.GameMode == "PvBot" ? "Solo vs AI" : "Pass & Play")
                    </span>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <button type="button"
                            class="p-2.5 rounded-2xl border text-left transition-all flex items-center gap-2.5 @(Config.GameMode == "PvBot" ? "bg-amber-500/20 border-amber-400 text-white shadow-md ring-1 ring-amber-400/40" : "bg-slate-800/50 border-slate-700/60 text-slate-300 hover:bg-slate-800")"
                            @onclick='() => SetGameMode("PvBot")'>
                        <div class="w-8 h-8 rounded-xl bg-amber-500/20 border border-amber-400/40 flex items-center justify-center text-lg shrink-0">
                            🤖
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs font-bold text-amber-300 truncate">Play vs Bot (AI)</p>
                            <p class="text-[10px] text-slate-400 truncate">Challenge computer AI</p>
                        </div>
                    </button>

                    <button type="button"
                            class="p-2.5 rounded-2xl border text-left transition-all flex items-center gap-2.5 @(Config.GameMode == "PvP" ? "bg-amber-500/20 border-amber-400 text-white shadow-md ring-1 ring-amber-400/40" : "bg-slate-800/50 border-slate-700/60 text-slate-300 hover:bg-slate-800")"
                            @onclick='() => SetGameMode("PvP")'>
                        <div class="w-8 h-8 rounded-xl bg-slate-700/40 border border-slate-600/40 flex items-center justify-center text-lg shrink-0">
                            👥
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs font-bold text-slate-200 truncate">Pass & Play</p>
                            <p class="text-[10px] text-slate-400 truncate">Same screen friends</p>
                        </div>
                    </button>
                </div>

                <!-- Bot Skill Level Quick Bar (Visible in PvBot mode) -->
                @if (Config.GameMode == "PvBot")
                {
                    <div class="pt-1 flex items-center justify-between gap-2 p-2 rounded-xl bg-slate-900/60 border border-slate-800">
                        <span class="text-[11px] font-bold text-slate-300 flex items-center gap-1">
                            <span>🧠</span>
                            <span>Bot AI Skill:</span>
                        </span>
                        <div class="flex items-center gap-1">
                            @foreach (var diff in new[] { ("Easy", "🟢 Rookie"), ("Medium", "🟡 Tactical"), ("Hard", "🔴 Master") })
                            {
                                var isDiffSelected = Config.DefaultBotDifficulty == diff.Item1;
                                <button type="button"
                                        class="px-2 py-1 rounded-lg text-[10px] font-bold transition-all @(isDiffSelected ? "bg-amber-500 text-slate-950 shadow" : "bg-slate-800 text-slate-400 hover:text-slate-200")"
                                        @onclick="() => SetGlobalDifficulty(diff.Item1)">
                                    @diff.Item2
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Player Count Picker -->
            <div class="space-y-1.5 shrink-0">
                <div class="flex items-center justify-between">
                    <label class="text-xs sm:text-sm font-bold text-slate-200 flex items-center gap-1.5">
                        <span>👥</span>
                        <span>Number of Players</span>
                    </label>
                    <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30">
                        @Config.NumberOfPlayer Players
                    </span>
                </div>
                <div class="grid grid-cols-7 gap-1.5 sm:gap-2">
                    @foreach (var count in new[] { 2, 3, 4, 5, 6, 7, 8 })
                    {
                        var isSelected = Config.NumberOfPlayer == count;
                        <button type="button"
                                class="py-2 sm:py-2.5 rounded-2xl font-black text-sm sm:text-base transition-all duration-150 flex flex-col items-center justify-center @(isSelected ? "bg-amber-500 text-slate-950 shadow-lg shadow-amber-500/30 scale-105 border-2 border-amber-300" : "bg-slate-800/60 text-slate-300 hover:bg-slate-700/60 border border-slate-700/50")"
                                @onclick="() => SetPlayerCount(count)">
                            <span>@count</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Tab Navigation -->
            <div class="flex p-1 rounded-2xl bg-slate-950/60 border border-slate-800 text-xs sm:text-sm font-semibold shrink-0">
                <button type="button"
                        class="flex-1 py-1.5 rounded-xl transition-all @(activeTab == "players" ? "bg-slate-800 text-amber-400 shadow" : "text-slate-400 hover:text-slate-200")"
                        @onclick='() => activeTab = "players"'>
                    🎨 Players (@Config.NumberOfPlayer)
                </button>
                <button type="button"
                        class="flex-1 py-1.5 rounded-xl transition-all @(activeTab == "board" ? "bg-slate-800 text-amber-400 shadow" : "text-slate-400 hover:text-slate-200")"
                        @onclick='() => activeTab = "board"'>
                    📐 Grid Arena
                </button>
                <button type="button"
                        class="flex-1 py-1.5 rounded-xl transition-all @(activeTab == "settings" ? "bg-slate-800 text-amber-400 shadow" : "text-slate-400 hover:text-slate-200")"
                        @onclick='() => activeTab = "settings"'>
                    ⚙️ Options
                </button>
            </div>

            <!-- Tab 1: Players Customization -->
            @if (activeTab == "players")
            {
                <div class="custom-scrollbar max-h-[36vh] sm:max-h-[42vh] overflow-y-auto overscroll-contain pr-1 pt-1 pb-1">
                    <div class="grid grid-cols-1 @(Config.NumberOfPlayer > 3 ? "sm:grid-cols-2" : "grid-cols-1") gap-2">
                        @for (int i = 0; i < Config.NumberOfPlayer && i < Config.PlayerList.Count; i++)
                        {
                            var index = i;
                            var player = Config.PlayerList[i];
                            <div class="p-2.5 rounded-2xl bg-slate-800/60 border border-slate-700/60 space-y-2">
                                <div class="flex items-center gap-2">
                                    <!-- Player Avatar Badge -->
                                    <div class="w-7 h-7 rounded-full shadow-md shrink-0 border border-white/40 flex items-center justify-center text-xs font-black relative"
                                         style="background: @player.ColorFormed(); color: @player.ContrastTextColor;">
                                        @if (player.IsBot)
                                        {
                                            <span>🤖</span>
                                        }
                                        else
                                        {
                                            <span>@(index + 1)</span>
                                        }
                                    </div>
                                    
                                    <!-- Editable Nickname Input -->
                                    <div class="flex-1 min-w-0">
                                        <input type="text"
                                               @bind="player.Name"
                                               maxlength="16"
                                               placeholder="Player @(index + 1)"
                                               class="w-full px-2.5 py-1 rounded-xl bg-slate-900/80 border border-slate-700 text-slate-100 text-xs font-semibold focus:outline-none focus:border-amber-400" />
                                    </div>

                                    <!-- Human / Bot Toggle -->
                                    <button type="button"
                                            class="px-2 py-1 rounded-xl text-xs font-bold transition-all flex items-center gap-1 shrink-0 @(player.IsBot ? "bg-purple-600/30 border border-purple-500/50 text-purple-300 hover:bg-purple-600/40" : "bg-slate-700/50 border border-slate-600/50 text-slate-300 hover:bg-slate-700")"
                                            @onclick="() => TogglePlayerBot(index)"
                                            title="Toggle Human or AI Bot">
                                        <span>@(player.IsBot ? "🤖 Bot" : "👤 Human")</span>
                                    </button>

                                    <!-- Custom Color Picker & Reset -->
                                    <div class="flex items-center gap-1 shrink-0">
                                        <label class="w-7 h-7 rounded-xl cursor-pointer border border-slate-600 flex items-center justify-center overflow-hidden hover:scale-105 transition-transform"
                                               style="background: @player.ColorFormed();"
                                               title="Pick custom color">
                                            <input type="color"
                                                   value="@player.HexColor"
                                                   @onchange="@(e => SetPlayerHexColor(index, e.Value?.ToString() ?? "#ef4444"))"
                                                   class="opacity-0 w-full h-full cursor-pointer" />
                                        </label>
                                        <button type="button"
                                                class="w-7 h-7 rounded-xl bg-slate-700/60 hover:bg-slate-600/60 text-slate-300 text-xs flex items-center justify-center transition-colors"
                                                @onclick="() => ResetPlayer(index)"
                                                title="Reset to default">
                                            🔄
                                        </button>
                                    </div>
                                </div>

                                <!-- Bot Difficulty Selector if Bot -->
                                @if (player.IsBot)
                                {
                                    <div class="flex items-center justify-between gap-1.5 px-2 py-1 rounded-xl bg-slate-900/60 border border-slate-800 text-[10px]">
                                        <span class="font-bold text-slate-400">Bot Difficulty:</span>
                                        <div class="flex items-center gap-1">
                                            @foreach (var diff in new[] { "Easy", "Medium", "Hard" })
                                            {
                                                var isDiff = player.BotDifficulty == diff;
                                                <button type="button"
                                                        class="px-1.5 py-0.5 rounded font-bold transition-all @(isDiff ? "bg-amber-500 text-slate-950" : "bg-slate-800 text-slate-400 hover:text-white")"
                                                        @onclick="() => SetPlayerBotDifficulty(index, diff)">
                                                    @diff
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }

                                <!-- Color Quick Palette Swatches -->
                                <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
                                    @foreach (var colorPreset in Config.PresetColors)
                                    {
                                        var isColorSelected = player.RColor == colorPreset.R && player.GColor == colorPreset.G && player.BColor == colorPreset.B;
                                        <button type="button"
                                                class="w-5 h-5 rounded-full transition-transform @(isColorSelected ? "ring-2 ring-white scale-110 shadow" : "opacity-75 hover:opacity-100 hover:scale-105")"
                                                style="background: rgb(@colorPreset.R, @colorPreset.G, @colorPreset.B);"
                                                @onclick="() => SetPlayerColor(index, colorPreset)"
                                                title="@colorPreset.Name">
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Tab 2: Grid Arena Configuration -->
            @if (activeTab == "board")
            {
                <div class="space-y-3 animate-fade-in pt-1 pb-1">
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                        <button type="button"
                                class="p-3 rounded-2xl border text-left transition-all @(Config.BoardPreset == "Auto" ? "bg-amber-500/20 border-amber-400 text-white shadow-md" : "bg-slate-800/40 border-slate-700/60 text-slate-300 hover:bg-slate-800")"
                                @onclick='() => SetBoardPreset("Auto")'>
                            <p class="text-xs font-bold text-amber-400">⚡ Auto Fit</p>
                            <p class="text-[11px] text-slate-400">Smart screen fit</p>
                        </button>

                        <button type="button"
                                class="p-3 rounded-2xl border text-left transition-all @(Config.BoardPreset == "Quick" ? "bg-amber-500/20 border-amber-400 text-white shadow-md" : "bg-slate-800/40 border-slate-700/60 text-slate-300 hover:bg-slate-800")"
                                @onclick='() => SetBoardPreset("Quick")'>
                            <p class="text-xs font-bold text-amber-400">📱 Quick 6×4</p>
                            <p class="text-[11px] text-slate-400">Fast 2-3 players</p>
                        </button>

                        <button type="button"
                                class="p-3 rounded-2xl border text-left transition-all @(Config.BoardPreset == "Classic" ? "bg-amber-500/20 border-amber-400 text-white shadow-md" : "bg-slate-800/40 border-slate-700/60 text-slate-300 hover:bg-slate-800")"
                                @onclick='() => SetBoardPreset("Classic")'>
                            <p class="text-xs font-bold text-amber-400">🎯 Classic 9×6</p>
                            <p class="text-[11px] text-slate-400">Balanced arena</p>
                        </button>

                        <button type="button"
                                class="p-3 rounded-2xl border text-left transition-all @(Config.BoardPreset == "Large" ? "bg-amber-500/20 border-amber-400 text-white shadow-md" : "bg-slate-800/40 border-slate-700/60 text-slate-300 hover:bg-slate-800")"
                                @onclick='() => SetBoardPreset("Large")'>
                            <p class="text-xs font-bold text-amber-400">🌋 Large 12×8</p>
                            <p class="text-[11px] text-slate-400">Chaotic 4-8 players</p>
                        </button>
                    </div>

                    @if (Config.BoardPreset == "Custom" || Config.IsCusTomDimention)
                    {
                        <div class="p-3.5 rounded-2xl bg-slate-800/50 border border-slate-700/50 grid grid-cols-2 gap-3">
                            <div class="space-y-1">
                                <label class="text-xs font-bold text-slate-300">↕️ Rows (4–25)</label>
                                <input type="number" min="4" max="25" @bind="Config.Rows"
                                       class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white font-bold text-sm focus:outline-none focus:border-amber-400" />
                            </div>
                            <div class="space-y-1">
                                <label class="text-xs font-bold text-slate-300">↔️ Columns (4–25)</label>
                                <input type="number" min="4" max="25" @bind="Config.Column"
                                       class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white font-bold text-sm focus:outline-none focus:border-amber-400" />
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Tab 3: Options & Settings -->
            @if (activeTab == "settings")
            {
                <div class="space-y-3 animate-fade-in pt-1 pb-1">
                    <!-- Chain Reaction Speed -->
                    <div class="p-3 rounded-2xl bg-slate-800/50 border border-slate-700/50 space-y-2">
                        <label class="text-xs font-bold text-slate-300 flex items-center gap-1.5">
                            <span>⚡</span>
                            <span>Explosion Speed</span>
                        </label>
                        <div class="grid grid-cols-3 gap-2">
                            @foreach (var speed in new[] { "Fast", "Normal", "Dramatic" })
                            {
                                <button type="button"
                                        class="py-2 px-3 rounded-xl text-xs font-bold transition-all @(Config.GameSpeed == speed ? "bg-amber-500 text-slate-950 shadow" : "bg-slate-900/80 text-slate-400 hover:text-white")"
                                        @onclick="() => Config.GameSpeed = speed">
                                    @speed
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Audio & Feedback -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                        <label class="flex items-center gap-3 p-3 rounded-2xl bg-slate-800/50 border border-slate-700/50 cursor-pointer hover:bg-slate-800/80 transition-colors">
                            <input type="checkbox" @bind="Config.Dhwani" class="w-5 h-5 rounded-lg border-slate-600 bg-slate-900 text-amber-500 focus:ring-amber-400 cursor-pointer" />
                            <div>
                                <p class="text-xs sm:text-sm font-bold text-slate-200">🔊 Sound Effects</p>
                                <p class="text-[11px] text-slate-400">Procedural pops & explosions</p>
                            </div>
                        </label>

                        <label class="flex items-center gap-3 p-3 rounded-2xl bg-slate-800/50 border border-slate-700/50 cursor-pointer hover:bg-slate-800/80 transition-colors">
                            <input type="checkbox" @bind="Config.Kampan" class="w-5 h-5 rounded-lg border-slate-600 bg-slate-900 text-amber-500 focus:ring-amber-400 cursor-pointer" />
                            <div>
                                <p class="text-xs sm:text-sm font-bold text-slate-200">📳 Haptic Vibration</p>
                                <p class="text-[11px] text-slate-400">Mobile explosion feedback</p>
                            </div>
                        </label>
                    </div>
                </div>
            }

        </div>
    </div>

    <!-- Bottom Action Bar -->
    <div class="w-full max-w-2xl mx-auto shrink-0 pt-1">
        <button type="button"
                class="game-btn w-full py-3.5 sm:py-4 rounded-2xl bg-gradient-to-r from-amber-500 via-amber-400 to-amber-500 hover:from-amber-400 hover:to-amber-300 text-slate-950 font-black text-base sm:text-lg tracking-wide shadow-xl shadow-amber-500/25 border border-amber-300/50 flex items-center justify-center gap-2.5 transition-all"
                @onclick="StartGame"
                style="font-family: 'Outfit', sans-serif;">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
            </svg>
            <span>@GetStartButtonText()</span>
        </button>
    </div>

</main>