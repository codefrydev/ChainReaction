@page "/"

<SlidingBubble/>
@if (showReleasePopup)
{
    <Modal IsOpen="showReleasePopup" IsOpenChanged="OnReleasePopupChanged" Title="🎉 New Game Released!" CloseOnBackdrop="true">
        <ChildContent>
            <div class="space-y-3 text-center sm:text-left">
                <p class="text-sm sm:text-base font-bold text-amber-900 leading-relaxed" style="font-family: 'Comic Sans MS', cursive;">
                    A brand-new <strong>online multiplayer</strong> Chain Reaction is live! Play with friends over the internet — no pass-and-play needed.
                </p>
                <div class="rounded-xl bg-amber-100/80 border-2 border-amber-400/50 px-3 py-2.5">
                    <p class="text-xs sm:text-sm font-bold text-amber-800" style="font-family: 'Comic Sans MS', cursive;">
                        🌍 chainreaction.codefrydev.in
                    </p>
                </div>
            </div>
        </ChildContent>
        <Footer>
            <div class="flex flex-col sm:flex-row gap-2 sm:gap-3 sm:justify-center">
                <a href="https://chainreaction.codefrydev.in/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="cartoon-btn inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-br from-yellow-400 via-amber-400 to-orange-500 text-amber-900 font-black shadow-lg hover:shadow-xl transition-all border-2 border-amber-800 text-sm sm:text-base"
                   style="font-family: 'Chewy', cursive;"
                   @onclick="DismissReleasePopup">
                    🌍 Try Online Game
                </a>
                <button type="button"
                        class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-white/90 text-amber-900 font-bold border-2 border-amber-500/50 hover:bg-amber-50 transition-all text-sm sm:text-base"
                        style="font-family: 'Comic Sans MS', cursive;"
                        @onclick="DismissReleasePopup">
                    Continue Here
                </button>
            </div>
        </Footer>
    </Modal>
}
<main class="home-page min-h-[100dvh] w-full max-w-full overflow-x-hidden flex flex-col">
    <div class="flex-1 min-h-0 overflow-y-auto overflow-x-hidden home-page-scroll">
        <div class="home-page-center min-h-full flex flex-col justify-center px-3 sm:px-4 py-4 sm:py-6">
            <div class="mx-auto w-full max-w-lg sm:max-w-xl md:max-w-2xl flex flex-col gap-2 sm:gap-3">
            <HelpButton />
            <div class="flex flex-col gap-3 sm:gap-4 backdrop-blur-xl bg-gradient-to-br from-amber-100/90 via-yellow-100/90 to-orange-100/90 rounded-2xl sm:rounded-3xl shadow-2xl ring-4 ring-amber-800/30 p-4 sm:p-5 md:p-6 border-4 border-amber-700/50 min-w-0">
            
            <!-- Header -->
            <header class="text-center space-y-1 sm:space-y-2">
                <div class="flex items-center justify-center gap-2 sm:gap-3">
                    <span class="text-2xl sm:text-4xl">🐱</span>
                    <span class="text-2xl sm:text-4xl">💥</span>
                    <span class="text-2xl sm:text-4xl">🧀</span>
                </div>
                <h1 class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight bg-gradient-to-r from-blue-600 via-amber-600 to-orange-600 bg-clip-text text-transparent break-words leading-tight">
                    Chain Reaction
                </h1>
                <p class="text-amber-900 text-xs sm:text-sm font-bold" style="font-family: 'Comic Sans MS', cursive;">
                    Local pass-and-play on one device
                </p>
            </header>

            <!-- Online Multiplayer -->
            <a href="https://chainreaction.codefrydev.in/"
               target="_blank"
               rel="noopener noreferrer"
               class="flex items-center justify-between gap-3 rounded-xl p-3 sm:p-4 bg-white/75 hover:bg-amber-50/90 text-amber-950 shadow-sm hover:shadow-md hover:scale-[1.01] transition-all border-2 border-amber-600/45 hover:border-amber-700/70 group">
                <div class="min-w-0 text-left">
                    <p class="font-black text-sm sm:text-base truncate text-amber-900" style="font-family: 'Comic Sans MS', cursive;">🌍 Play Online Multiplayer</p>
                    <p class="text-xs text-amber-700/90 truncate">chainreaction.codefrydev.in</p>
                </div>
                <svg class="w-5 h-5 shrink-0 text-amber-800 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
            </a>

            <!-- Number of Players -->
            <section class="space-y-2 bg-white/60 rounded-xl p-3 sm:p-4 border-3 border-amber-600/30 shadow-cartoon">
                <label class="block text-sm sm:text-base font-black text-amber-900" style="font-family: 'Comic Sans MS', cursive;">
                    🎮 Number of Players
                </label>
                <div class="flex flex-wrap gap-2">
                    @foreach (var playerCount in new[] { 2, 3, 4, 5, 6 })
                    {
                        <label class="@GetPlayerButtonClass(playerCount)">
                            <input type="radio" 
                                   name="playerCount" 
                                   value="@playerCount" 
                                   checked="@(Config.NumberOfPlayer == playerCount)"
                                   @onchange="() => SelectPlayerCount(playerCount)"
                                   class="sr-only" />
                            <span class="font-black text-sm md:text-base">@playerCount</span>
                        </label>
                    }
                </div>
            </section>

            <!-- Player Color Customization -->
            <div class="bg-gradient-to-br from-purple-100/70 to-pink-100/70 rounded-xl border-3 border-purple-600/40 shadow-cartoon overflow-hidden">
                <button type="button" @onclick='() => TogglePanel("colors")'
                        class="w-full p-3 sm:p-4 cursor-pointer font-bold text-purple-900 flex items-center justify-between select-none text-sm sm:text-base text-left"
                        style="font-family: 'Comic Sans MS', cursive;"
                        aria-expanded="@IsPanelOpen("colors")">
                    <span class="flex items-center gap-2 min-w-0">
                        <span class="shrink-0">🎨</span>
                        <span class="truncate">Customize Player Colors</span>
                    </span>
                    <svg class="w-5 h-5 shrink-0 text-purple-700 transition-transform @(IsPanelOpen("colors") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                @if (IsPanelOpen("colors"))
                {
                <div class="accordion-body px-3 sm:px-4 pb-3 sm:pb-4 space-y-2 border-t border-purple-300/40">
                    @for (int i = 0; i < Config.NumberOfPlayer && i < Config.PlayerList.Count; i++)
                    {
                        var player = Config.PlayerList[i];
                        var index = i;
                        <div class="p-2 sm:p-3 rounded-xl bg-white/70 border-2 border-purple-500/30 shadow-sm">
                            <div class="flex items-center gap-3 mb-2 min-w-0">
                                <div class="w-8 h-8 rounded-full shadow-md border-3 border-purple-600 transition-all shrink-0" 
                                     style="background: @player.ColorFormed();"></div>
                                <span class="font-bold text-sm md:text-base text-purple-900 truncate min-w-0" style="font-family: 'Comic Sans MS', cursive;">
                                    @player.Name
                                </span>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                                <div>
                                    <label class="block text-xs font-bold text-red-700 mb-1" style="font-family: 'Comic Sans MS', cursive;">🔴 Red</label>
                                    <input type="range" min="0" max="255" 
                                           value="@player.RColor" 
                                           @oninput="@(e => UpdatePlayerColor(index, 'R', int.Parse(e.Value?.ToString() ?? "0")))"
                                           class="w-full h-2 bg-red-200 rounded-lg appearance-none cursor-pointer accent-red-500" />
                                    <div class="text-center text-xs font-bold text-red-900 mt-1">@player.RColor</div>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-green-700 mb-1" style="font-family: 'Comic Sans MS', cursive;">🟢 Green</label>
                                    <input type="range" min="0" max="255" 
                                           value="@player.GColor" 
                                           @oninput="@(e => UpdatePlayerColor(index, 'G', int.Parse(e.Value?.ToString() ?? "0")))"
                                           class="w-full h-2 bg-green-200 rounded-lg appearance-none cursor-pointer accent-green-500" />
                                    <div class="text-center text-xs font-bold text-green-900 mt-1">@player.GColor</div>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-blue-700 mb-1" style="font-family: 'Comic Sans MS', cursive;">🔵 Blue</label>
                                    <input type="range" min="0" max="255" 
                                           value="@player.BColor" 
                                           @oninput="@(e => UpdatePlayerColor(index, 'B', int.Parse(e.Value?.ToString() ?? "0")))"
                                           class="w-full h-2 bg-blue-200 rounded-lg appearance-none cursor-pointer accent-blue-500" />
                                    <div class="text-center text-xs font-bold text-blue-900 mt-1">@player.BColor</div>
                                </div>
                            </div>
                            <div class="mt-2 flex gap-2">
                                <input type="color" 
                                       value="@RgbToHex(player.RColor, player.GColor, player.BColor)" 
                                       @onchange="@(e => UpdatePlayerColorFromHex(index, e.Value?.ToString() ?? "#000000"))"
                                       class="w-full h-10 rounded-lg cursor-pointer border-2 border-purple-600" 
                                       title="Pick a color" />
                                <button @onclick="@(() => ResetPlayerColor(index))" 
                                        class="px-3 py-2 rounded-lg bg-amber-400 hover:bg-amber-500 text-amber-900 font-bold text-xs shadow-md hover:shadow-lg transition-all border-2 border-amber-600"
                                        style="font-family: 'Comic Sans MS', cursive;">
                                    🔄 Reset
                                </button>
                            </div>
                        </div>
                    }
                </div>
                }
            </div>

            <!-- Advanced Settings -->
            <div class="bg-gradient-to-br from-white/70 to-yellow-50/70 rounded-xl border-3 border-amber-600/40 shadow-cartoon overflow-hidden">
                <button type="button" @onclick='() => TogglePanel("settings")'
                        class="w-full p-3 sm:p-4 cursor-pointer font-bold text-amber-900 flex items-center justify-between select-none text-sm sm:text-base text-left"
                        style="font-family: 'Comic Sans MS', cursive;"
                        aria-expanded="@IsPanelOpen("settings")">
                    <span class="flex items-center gap-2 min-w-0">
                        <span class="shrink-0">⚙️</span>
                        <span class="truncate">Advanced Settings</span>
                    </span>
                    <svg class="w-5 h-5 shrink-0 text-amber-700 transition-transform @(IsPanelOpen("settings") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                @if (IsPanelOpen("settings"))
                {
                <div class="accordion-body px-3 sm:px-4 pb-3 sm:pb-4 space-y-2 border-t border-amber-300/40">
                    <label class="flex items-center gap-3 p-2.5 sm:p-3 rounded-lg bg-yellow-50/70 border-2 border-amber-500/30 cursor-pointer">
                        <input type="checkbox" @bind="Config.Kampan" class="h-5 w-5 rounded-lg border-2 border-amber-600 text-yellow-500 focus:ring-yellow-400 cursor-pointer shrink-0" />
                        <div class="flex-1 min-w-0">
                            <div class="font-bold text-sm text-amber-900" style="font-family: 'Comic Sans MS', cursive;">📳 Vibration</div>
                        </div>
                    </label>
                    
                    <label class="flex items-center gap-3 p-2.5 sm:p-3 rounded-lg bg-yellow-50/70 border-2 border-amber-500/30 cursor-pointer">
                        <input type="checkbox" @bind="Config.Dhwani" class="h-5 w-5 rounded-lg border-2 border-amber-600 text-yellow-500 focus:ring-yellow-400 cursor-pointer shrink-0" />
                        <div class="flex-1 min-w-0">
                            <div class="font-bold text-sm text-amber-900" style="font-family: 'Comic Sans MS', cursive;">🔊 Sound Effects</div>
                        </div>
                    </label>
                    
                    <label class="flex items-center gap-3 p-2.5 sm:p-3 rounded-lg bg-yellow-50/70 border-2 border-amber-500/30 cursor-pointer">
                        <input type="checkbox" @bind="Config.IsCusTomDimention" class="h-5 w-5 rounded-lg border-2 border-amber-600 text-yellow-500 focus:ring-yellow-400 cursor-pointer shrink-0" />
                        <div class="flex-1 min-w-0">
                            <div class="font-bold text-sm text-amber-900" style="font-family: 'Comic Sans MS', cursive;">📐 Custom Dimensions</div>
                        </div>
                    </label>

                    @if(Config.IsCusTomDimention)
                    {
                        <div class="grid grid-cols-2 gap-2 pt-1">
                            <div class="space-y-1">
                                <label class="block text-xs font-black text-amber-900" style="font-family: 'Comic Sans MS', cursive;">↕️ Rows</label>
                                <input type="number" @bind="Config.Rows" min="4" max="100" step="1" 
                                    class="w-full px-3 py-2 rounded-lg border-2 border-amber-600 bg-yellow-50 text-amber-900 font-bold text-sm focus:outline-none focus:ring-2 focus:ring-yellow-400" />
                            </div>
                            <div class="space-y-1">
                                <label class="block text-xs font-black text-amber-900" style="font-family: 'Comic Sans MS', cursive;">↔️ Columns</label>
                                <input type="number" @bind="Config.Column" min="4" max="100" step="1" 
                                    class="w-full px-3 py-2 rounded-lg border-2 border-amber-600 bg-yellow-50 text-amber-900 font-bold text-sm focus:outline-none focus:ring-2 focus:ring-yellow-400" />
                            </div>
                        </div>
                    }
                </div>
                }
            </div>

            </div>
            </div>
        </div>
    </div>

    <!-- Play button — fixed on mobile so it stays visible when panels expand -->
    <div class="home-play-bar shrink-0">
        <div class="mx-auto w-full max-w-lg sm:max-w-xl md:max-w-2xl px-3 sm:px-4">
            <button class="cartoon-btn w-full sm:max-w-sm sm:mx-auto sm:flex px-6 py-3.5 sm:py-4 rounded-2xl bg-gradient-to-br from-yellow-400 via-amber-400 to-orange-500 text-amber-900 text-base sm:text-lg font-black shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-0.5 active:scale-95 border-3 border-amber-700" @onclick="StartGame" style="font-family: 'Chewy', cursive;">
                <span class="relative z-10 flex items-center justify-center gap-2">
                    <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
                    </svg>
                    🎮 Start the Chase!
                </span>
            </button>
            <p class="text-center text-xs text-amber-800/80 font-semibold mt-1.5 sm:mt-2" style="font-family: 'Comic Sans MS', cursive;">
                @Config.NumberOfPlayer player@(Config.NumberOfPlayer > 1 ? "s" : "") · local game
            </p>
        </div>
    </div>
</main>

@code {
    // Store default colors for reset functionality
    private static readonly List<(int R, int G, int B)> DefaultColors = new()
    {
        (70, 130, 180),   // Blue Cat
        (205, 133, 63),   // Brown Mouse
        (255, 140, 0),    // Orange
        (255, 215, 0),    // Yellow Cheese
        (60, 179, 113),   // Green
        (147, 112, 219)   // Purple
    };

    private string? openPanel;

    private void TogglePanel(string panel)
    {
        openPanel = openPanel == panel ? null : panel;
    }

    private bool IsPanelOpen(string panel) => openPanel == panel;

    private void SelectPlayerCount(int count)
    {
        Config.NumberOfPlayer = count;
        StateHasChanged();
    }

    private string GetPlayerButtonClass(int playerCount)
    {
        var baseClass = "flex items-center justify-center min-w-[40px] sm:min-w-[48px] px-3 py-2 rounded-lg border-3 cursor-pointer transition-all duration-200 font-black shadow-md hover:shadow-lg";
        var isSelected = Config.NumberOfPlayer == playerCount;
        
        if (isSelected)
        {
            return $"{baseClass} border-amber-700 bg-gradient-to-br from-yellow-400 to-amber-500 shadow-cartoon text-amber-900 scale-105";
        }
        else
        {
            return $"{baseClass} border-amber-600/40 bg-white/90 text-amber-800 hover:bg-yellow-50 hover:border-amber-600";
        }
    }

    private void UpdatePlayerColor(int playerIndex, char colorChannel, int value)
    {
        if (playerIndex >= 0 && playerIndex < Config.PlayerList.Count)
        {
            var player = Config.PlayerList[playerIndex];
            switch (colorChannel)
            {
                case 'R':
                    player.RColor = value;
                    break;
                case 'G':
                    player.GColor = value;
                    break;
                case 'B':
                    player.BColor = value;
                    break;
            }
            StateHasChanged();
        }
    }

    private void UpdatePlayerColorFromHex(int playerIndex, string hexColor)
    {
        if (playerIndex >= 0 && playerIndex < Config.PlayerList.Count && !string.IsNullOrEmpty(hexColor))
        {
            // Remove # if present
            hexColor = hexColor.TrimStart('#');
            
            if (hexColor.Length == 6)
            {
                try
                {
                    var player = Config.PlayerList[playerIndex];
                    player.RColor = Convert.ToInt32(hexColor.Substring(0, 2), 16);
                    player.GColor = Convert.ToInt32(hexColor.Substring(2, 2), 16);
                    player.BColor = Convert.ToInt32(hexColor.Substring(4, 2), 16);
                    StateHasChanged();
                }
                catch
                {
                    // Invalid hex color, ignore
                }
            }
        }
    }

    private void ResetPlayerColor(int playerIndex)
    {
        if (playerIndex >= 0 && playerIndex < Config.PlayerList.Count && playerIndex < DefaultColors.Count)
        {
            var player = Config.PlayerList[playerIndex];
            var defaultColor = DefaultColors[playerIndex];
            player.RColor = defaultColor.R;
            player.GColor = defaultColor.G;
            player.BColor = defaultColor.B;
            StateHasChanged();
        }
    }

    private string RgbToHex(int r, int g, int b)
    {
        return $"#{r:X2}{g:X2}{b:X2}";
    }
}